# Copier en .env.prod sur le serveur et remplacer CHAQUE valeur « a-changer ».
# Ne jamais versionner .env.prod.

# Domaines (HTTPS automatique via Caddy)
DOMAINE_WEB=dashboard.exemple.cm
DOMAINE_API=api.exemple.cm

# Base de données (mêmes valeurs que POSTGRES_* du service postgres)
DATABASE_USER=camaircost
DATABASE_PASSWORD=a-changer
DATABASE_NAME=camaircost

# Secret de signature des sessions et des liens de fichiers : 64 caractères aléatoires minimum
# (par exemple : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET=a-changer

# Premier compte administrateur, créé au premier démarrage s'il n'existe pas
ADMIN_EMAIL=admin@exemple.cm
ADMIN_PASSWORD=a-changer

# Horodatage certifié RFC 3161 : choisir une autorité d'horodatage reconnue au Cameroun.
# Vide = désactivé.
TSA_URL=

# Cookie de session réservé à HTTPS (laisser à true derrière Caddy)
COOKIE_SECURE=true

# Analyse IA des photos (plaques, dégâts, zone de choc, météo) qui pré-remplit
# le formulaire et oriente la reconstitution 3D. Laisser vide pour désactiver :
# le reste de l'application fonctionne sans.
ANTHROPIC_API_KEY=
# Identifiant du modèle de vision (obligatoire pour activer l'analyse).
IA_MODELE=
